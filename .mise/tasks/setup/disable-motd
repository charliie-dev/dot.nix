#!/usr/bin/env bash
#MISE description="Keep concise Ubuntu MOTD while suppressing remote news and Pro ads"
#MISE raw=true

set -euo pipefail

MOTD_DIR="/etc/update-motd.d"

# Keep the standard current update count in the login MOTD.
if ! dpkg-query -W -f='${db:Status-Status}' update-notifier-common 2>/dev/null | grep -q '^installed$'; then
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y update-notifier-common
  echo "Installed update-notifier-common"
fi

# Restore the package-owned file if an older version of this task patched it.
APT_CHECK="/usr/lib/update-notifier/apt_check.py"
if [[ -f "$APT_CHECK" ]] && grep -q "disabled by disable-motd" "$APT_CHECK"; then
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install --reinstall -y update-notifier-common
  echo "Restored package-owned apt_check.py"
fi

# motd-news.service executes this script directly, so chmod -x causes
# status=203/EXEC. Keep it executable, disable its supported config switch, and
# stop the timer that fetches remote news.
MOTD_NEWS="${MOTD_DIR}/50-motd-news"
MOTD_NEWS_DEFAULTS="/etc/default/motd-news"
if [[ -f "$MOTD_NEWS" ]]; then
  sudo chmod 0755 "$MOTD_NEWS"
fi
defaults_tmp=$(mktemp)
trap 'rm -f "$defaults_tmp" "${defaults_tmp}.new"' EXIT
if sudo test -f "$MOTD_NEWS_DEFAULTS"; then
  sudo cat "$MOTD_NEWS_DEFAULTS" | tee "$defaults_tmp" >/dev/null
fi
awk '
  /^ENABLED=/ {
    if (!seen) print "ENABLED=0"
    seen = 1
    next
  }
  { print }
  END { if (!seen) print "ENABLED=0" }
' "$defaults_tmp" >"${defaults_tmp}.new"
sudo install -o root -g root -m 0644 "${defaults_tmp}.new" "$MOTD_NEWS_DEFAULTS"
rm -f "$defaults_tmp" "${defaults_tmp}.new"
trap - EXIT
if systemctl cat motd-news.timer &>/dev/null; then
  sudo systemctl disable --now motd-news.timer
fi
if systemctl is-failed --quiet motd-news.service; then
  sudo systemctl reset-failed motd-news.service
fi
echo "Ubuntu remote MOTD news disabled"

# Disable local login-only MOTD scripts. Unlike 50-motd-news, these files are
# not used as systemd ExecStart targets.
DISABLE_LIST=(
  "10-help-text"        # Ubuntu usage tips (man / manpath / info command hints)
  "60-unminimize"       # Prompt to restore full Ubuntu packages from minimal install
  "80-esm"              # Ubuntu Pro ESM available package count notice
  "88-esm-announce"     # Ubuntu Pro ESM upsell ad (complements 80-esm)
  "91-contract-ua-esm-status" # Ubuntu Advantage contract and ESM license status
)

for name in "${DISABLE_LIST[@]}"; do
  path="${MOTD_DIR}/${name}"
  if [[ -x "$path" ]]; then
    sudo chmod -x "$path"
    echo "Disabled: ${name}"
  elif [[ -f "$path" ]]; then
    echo "Already disabled: ${name}"
  else
    echo "Not found (skipped): ${name}"
  fi
done

echo "MOTD scripts disabled!"

# Disable any remaining ESM/Ubuntu Pro scripts not covered by the named list above
# (script numbers vary across Ubuntu versions)
for path in "$MOTD_DIR"/*; do
  [[ -x "$path" ]] || continue
  name="$(basename "$path")"
  case "$name" in
    *esm* | *ubuntu-advantage* | *ubuntu-pro* | *contract* | *ua-*)
      sudo chmod -x "$path"
      echo "Disabled (pattern): ${name}"
      ;;
  esac
done

# Clear cached ubuntu-pro MOTD message files written by the ua-timer service.
# These persist independently of the update-motd.d scripts and can still appear
# via PAM or other display mechanisms.
UA_MSG_DIR="/var/lib/ubuntu-advantage/messages"
if [[ -d "$UA_MSG_DIR" ]]; then
  sudo find "$UA_MSG_DIR" -maxdepth 1 -name "motd-*" -type f -delete
  echo "Cleared ubuntu-pro cached MOTD messages"
fi

# Suppress Ubuntu Pro upsell messages in apt/apt-get output
if command -v pro &>/dev/null; then
  sudo pro config set apt_news=false
  echo "Ubuntu Pro apt ads disabled!"
else
  echo "ubuntu-advantage-tools not found (skipped)"
fi

# update-notifier supports suppressing only ESM lines while retaining the
# regular update count. Rebuild its cache with that supported switch.
UPDATE_NOTIFIER="/usr/lib/update-notifier/update-motd-updates-available"
if [[ -x "$UPDATE_NOTIFIER" ]]; then
  sudo install -o root -g root -m 0644 /dev/null /var/lib/update-notifier/hide-esm-in-motd
  sudo "$UPDATE_NOTIFIER" --force
  echo "Ubuntu Pro ESM MOTD lines disabled"
fi

if [[ -f /var/cache/motd-news ]]; then
  sudo truncate -s 0 /var/cache/motd-news
  echo "Cleared cache: /var/cache/motd-news"
fi

# Some minimal images have pam_motd but no update-motd helper. Generate the
# cache directly so the next SSH login consistently sees the enabled scripts.
motd_tmp=$(mktemp)
trap 'rm -f "$motd_tmp"' EXIT
sudo run-parts --lsbsysinit "$MOTD_DIR" | tee "$motd_tmp" >/dev/null
sudo install -o root -g root -m 0644 "$motd_tmp" /run/motd.dynamic
rm -f "$motd_tmp"
trap - EXIT
echo "Regenerated MOTD"

# vim: ft=sh
