#!/usr/bin/env bash
# cf-as <account> <command...>
# Enter one fixed process-scoped Doppler profile; callers cannot select a
# project, config, or secret name.
set -euo pipefail

usage() {
  cat <<'EOF'
用法: cf-as <charliie|anmo> <command...>
EOF
}

account="${1:-}"
[ -n "$account" ] || { usage >&2; exit 1; }
shift
case "$account" in
  charliie) profile=cloudflare-charliie ;;
  anmo) profile=cloudflare-anmo ;;
  -h|--help) usage; exit 0 ;;
  *) echo "cf-as: 未知帳號 '$account'" >&2; usage >&2; exit 1 ;;
esac
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
[ "$#" -gt 0 ] || { echo "cf-as: 缺少要執行的命令" >&2; exit 1; }
exec doppler-run "$profile" -- "$@"
