#!/usr/bin/env bash
# cf-as <account> <command...>
#
# 用指定 Cloudflare 帳號的唯讀 token 跑一個命令。給的是目錄外的臨時查詢:
#
#   cf-as charliie flarectl dns list --zone charliie.dev
#   cf-as nicsra   flarectl zone list
#
# 只設唯讀 token。寫入一律走 docker repo 的 mise run cf:apply —— 寫入 token
# 在 sops 裡,只在那個 task 的當次 process 解密,不進任何常駐 shell。
#
# 這裡的帳號->變數名對照與 docker/cloudflare/.mise/tasks/lib/cf-auth 重複了
# 一次。刻意的:兩者住在不同 repo、生命週期不同(這支隨 home-manager 部署到
# 每台機器,那支只在 docker repo 內),為了三行對照去建跨 repo 相依不划算。
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
用法: cf-as <account> <command...>

帳號:
  charliie   charliie.dev   (charleschiu)
  anmo       anmo.tw        (AnmoAdmin)
  nicsra     nicsra.moda    (NICS(RA), 共管)

範例:
  cf-as charliie flarectl dns list --zone charliie.dev
EOF
}

account="${1:-}"
[ -n "$account" ] || { usage; exit 1; }
shift

case "$account" in
  charliie) ro_var=CF_TOKEN_CHARLIIE_RO; account_id=864dd04341d2aca5804853428630fbc4 ;;
  anmo)     ro_var=CF_TOKEN_ANMO_RO;     account_id="" ;;
  # nicsra 的 account ID 不寫在 repo 裡(公務網域的識別資訊),與
  # docker/cloudflare 的 lib/cf-auth 一致從 Doppler 注入。空值時下面的
  # [ -n "$account_id" ] 會跳過 export,行為與 anmo 目前的情況相同。
  nicsra)   ro_var=CF_TOKEN_NICSRA_RO;   account_id="${CF_ACCOUNT_ID_NICSRA:-}" ;;
  -h|--help) usage; exit 0 ;;
  *)
    echo "cf-as: 未知帳號 '$account'" >&2
    usage
    exit 1
    ;;
esac

[ $# -gt 0 ] || { echo "cf-as: 缺少要執行的命令" >&2; usage; exit 1; }

token="${!ro_var:-}"
if [ -z "$token" ]; then
  echo "cf-as: 環境變數 $ro_var 是空的" >&2
  echo "       它應該由 Doppler 在 shell 啟動時注入(dot-nix/dev_personal)" >&2
  echo "       修法: 開新 shell,或跑 home-manager switch 重新拉 Doppler" >&2
  exit 1
fi

export CF_API_TOKEN="$token"
export CLOUDFLARE_API_TOKEN="$token"
if [ -n "$account_id" ]; then
  export CF_ACCOUNT_ID="$account_id"
  export CLOUDFLARE_ACCOUNT_ID="$account_id"
fi

exec "$@"
